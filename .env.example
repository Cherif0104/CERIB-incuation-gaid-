# Supabase - Projet SAVANA
# Copiez ce fichier en .env.local et remplissez les valeurs.

# URL du projet Supabase (Data API) — requis pour le frontend
VITE_SUPABASE_URL=https://votre-projet.supabase.co

# Clé publique (Publishable Key ou Anon Key) — requis pour le frontend
# Récupérable dans Supabase → Settings → API
VITE_SUPABASE_ANON_KEY=sb_publishable_xxx

# Migrations & seeds : connexion directe Postgres (db:migrate, db:seed)
# Option A : mot de passe seul (URL construite depuis VITE_SUPABASE_URL)
# Supabase → Settings → Database → Database password (ou Reset)
SUPABASE_DB_PASSWORD=

# Option B : URL complète
# SUPABASE_DB_URL=postgresql://postgres:MOT_DE_PASSE@db.xxxxx.supabase.co:5432/postgres

# Optionnel : pour le script seed:dev (création de comptes de test — staging uniquement)
# Ne jamais committer ni exposer la clé service_role
# SUPABASE_SERVICE_ROLE_KEY=eyJ...

# Pour setup-new-project : migrations + Super Admin sans connexion Postgres directe
# Créer un token : https://supabase.com/dashboard/account/tokens (scope database:write)
# SUPABASE_ACCESS_TOKEN=sbp_xxx...
